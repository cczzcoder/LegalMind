APP_ENV=development

POSTGRES_USER=legalmind
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_DB=legalmind

# 经 HTTPS 访问时设为 true；production 下必须为 true
SESSION_COOKIE_SECURE=false

# 加密管理员 TOTP 密钥的 Fernet 密钥；未配置时管理员无法完成 MFA，production 下必填。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 更换密钥会使已绑定的 TOTP 失效，需逐个执行 reset-mfa
MFA_ENCRYPTION_KEY=

# 可信反向代理的 IP 或网段，逗号分隔（如 10.0.0.5,172.18.0.0/16）；
# 为空时忽略 X-Forwarded-For，登录限流按直连地址计数
TRUSTED_PROXIES=

# 原始文件存储目录。Docker 中固定为卷 artifacts_data（/data/artifacts），此项只在本机运行 API 时生效；
# 相对路径按启动目录解析，默认 data/artifacts（已在 .gitignore 中）
STORAGE_ROOT=data/artifacts
# 单个上传文件上限（字节），默认 50 MB
MAX_UPLOAD_BYTES=52428800

# ---- 文档解析（设计 6、7、14.2）----
# 第 1 层 PDF 后端：pypdfium2（PDFium，快、省内存）或 pdfplumber（pdfminer，布局归并更强）。
# 具体选型待样本基准按设计 §6 精度要求拍板，此处仅为默认值，可随时切换。
PARSING_PDF_BACKEND=pypdfium2
# 单次解析资源上限，超限主动拒绝/中止，避免 16 GB 单机 OOM。
PARSE_MAX_BYTES=52428800
PARSE_MAX_PAGES=2000
PARSE_MAX_CHARS=5000000
# 解析期间进程内存增长预算（MB），<=0 表示不限制
PARSE_MEMORY_BUDGET_MB=1024

# ---- 后台任务 worker（设计 12.2、14.2）----
# 单并发、按需启动；启动命令：python -m app.cli run-worker
# 任务租约（秒）：worker 每 1/3 租约期续租一次；租约过期会被其他 worker 回收重试
WORKER_LEASE_SECONDS=300
# 无任务时的轮询间隔（秒）
WORKER_POLL_SECONDS=5
# 失败重试的指数退避（秒）：base * 2^(attempt-1)，封顶 max
WORKER_BACKOFF_BASE_SECONDS=30
WORKER_BACKOFF_MAX_SECONDS=900

# 短期内容缓存（设计 §9.3 第三层、§14.1）：只用于待审队列的「当时答了什么」。
# **留空即禁用**——此时异步问答拒绝提交，同步问答照常。TTL 到期即焚。
CACHE_URL=redis://127.0.0.1:6379/0
ANSWER_CACHE_TTL_SECONDS=86400
